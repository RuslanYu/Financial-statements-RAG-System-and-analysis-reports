# Normalize text files to LF in repo; Windows can check out CRLF
* text=auto

# Force LF for these file types to avoid CRLF noise
*.py     text eol=lf
*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.md     text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
